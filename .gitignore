# 本地部署由 build.sh 复制到 docker/app/ 作为上下文）
dist/
/docker/app/

# runtime data
server/data/
*.db
*.db-wal
*.db-shm

# env & secrets
.env
.env.local

# logs
*.log

# OS
.DS_Store
Thumbs.db

# local tool settings
.claude/
.idea/
.scratch/

# preview prototype (superseded by web/, contains its own nested .git)
Preview/
extensions/
