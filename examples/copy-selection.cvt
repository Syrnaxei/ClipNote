/* ClipNote-Plugin
{
  "id": "copy-selection",
  "name": "复制选中",
  "author": "KanataN",
  "version": "1.0.0",
  "description": "把选中的文本写入系统剪贴板（演示 resolve 自定义成功文案）",
  "github_url": "github.com/KanataN",
  "type": "selection-toolbar",
  "regex": ".+",
  "button_name": "复制选中"
}
*/
async function process(input) {
  await navigator.clipboard.writeText(input);
  return '已复制选中的 ' + input.length + ' 个字符';
}
